# GitHub Fine-Grained API key for the target repository
GITHUB_TOKEN=your_github_fine_grained_token_here

# Shared secret used to verify X-Hub-Signature-256 on incoming webhook payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# IBM watsonx.ai credentials
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai model IDs
WATSONX_LLM_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_EMBED_MODEL_ID=ibm/slate-125m-english-rtrvr

# PostgreSQL connection string (pgvector-enabled)
DATABASE_URL=postgresql://prreviewer:prreviewer@localhost:5432/prreviewer

# External API contract registry fallback URL (optional)
EXTERNAL_API_REGISTRY_URL=https://your-api-registry.example.com
